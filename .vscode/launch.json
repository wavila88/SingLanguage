{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurar train.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/train/train.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "Depurar tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-s", "tests/test_train.py"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
